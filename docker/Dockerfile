# 1. Базовый образ: slim-версия весит ~150 МБ, а обычная ~1 ГБ. Экономим место.
FROM python:3.11-slim

# 2. Рабочая директория внутри контейнера (создается автоматически)
WORKDIR /app

# 3. ВАЖНО: Копируем ТОЛЬКО файл зависимостей ПЕРВЫМ.
# Если код изменится, а requirements.txt нет, Docker использует кэш для шага 4.
COPY requirements.txt .

# 4. Установка зависимостей. Флаг --no-cache-dir уменьшает размер образа.
RUN pip install --no-cache-dir -r requirements.txt

# 5. Теперь копируем весь остальной код. 
# Изменения здесь не заставят Docker заново устанавливать зависимости.
COPY . .

# 6. Команда, которая выполнится при запуске контейнера
CMD ["python", "app.py"]
